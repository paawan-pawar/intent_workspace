# ── Groq LLM (Free Tier) ──────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use (recommended: openai/gpt-oss-120b or qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# Intent Workspace — Environment Variables
# Copy this file to .env and fill in your values.

# ── Google Calendar Integration (Optional) ────────────────────
# Without these, the calendar connection operates in demo mode.
# See the setup instructions in the Connections page.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth callback URL — must match the redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8001/api/connections/google-calendar/oauth/callback

# Frontend URL — used for post-OAuth redirect
FRONTEND_URL=http://localhost:5173

# ── Gmail Integration (Optional) ──────────────────────────────
# Uses the same GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET as Calendar.
# The Gmail OAuth redirect URI must also be added in Google Cloud Console.

GOOGLE_REDIRECT_URI_GMAIL=http://localhost:8001/api/gmail/oauth/callback

# ── Gmail Pub/Sub Push Notifications (Optional) ───────────────
# Without this, the frontend polls for new emails every 30 seconds.
# Format: projects/YOUR_PROJECT_ID/topics/YOUR_TOPIC_NAME
# GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-push

# ── OpenAI (optional alternative) ─────────────────────────────
# OPENAI_API_KEY=sk-...